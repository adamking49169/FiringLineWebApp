@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <h1 class="fw-bold">Admin Dashboard</h1>
    <p class="text-muted">Only the site owner can access this area.</p>

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Manage Items</h5>
                    <p class="card-text text-muted">Add/remove content stored in the database.</p>
                    <a class="btn btn-danger" asp-area="Admin" asp-controller="SiteItems" asp-action="Index">
                        Open Manager
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
