@{
    var title = ViewData["Title"] as string ?? "FiringLine Hospitality Co.";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - FiringLine Hospitality Co.</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/gallery.css" />
</head>

<body>
    <header class="site-header border-bottom">
        <nav class="navbar navbar-expand-lg navbar-dark nav-dark py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo_clean.png" alt="FiringLine Hospitality Co." class="brand-logo" />
                    <span class="brand-name d-none d-sm-inline">FiringLine Hospitality Co.</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="services">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="coverage">Coverage</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Gallery">Gallery</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-brand" asp-controller="Home" asp-action="Index" asp-fragment="contact">
                                <i class="bi bi-envelope me-1"></i> Enquire
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer mt-5">
        <div class="container py-5">
            <div class="row g-4 align-items-start">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/logo_clean.png" alt="FiringLine Hospitality Co." class="brand-logo-sm" />
                        <strong>FiringLine Hospitality Co.</strong>
                    </div>
                    <p class="text-muted mb-2">
                        Temporary chef cover and hospitality support across Northern Ireland and border counties.
                    </p>
                    <p class="mb-0">
                        <a class="link-brand" href="mailto:firinglinehospitality@outlook.com">firinglinehospitality@outlook.com</a>
                    </p>
                </div>

                <div class="col-md-3">
                    <div class="footer-title">Company</div>
                    <ul class="list-unstyled mb-0">
                        <li>
                            <a class="footer-link" asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
                        </li>
                        <li>
                            <a class="footer-link" asp-controller="Home" asp-action="Index" asp-fragment="services">Services</a>
                        </li>
                        <li>
                            <a class="footer-link" asp-controller="Home" asp-action="Index" asp-fragment="coverage">Coverage</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <div class="footer-title">Get in touch</div>
                    <p class="text-muted mb-2">Phone number coming soon.</p>
                    <a class="btn btn-outline-brand w-100" href="#contact">
                        <i class="bi bi-chat-dots me-1"></i> Send an enquiry
                    </a>
                </div>
            </div>

            <hr class="my-4" />
            <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 small text-muted">
                <div>© @DateTime.UtcNow.Year FiringLine Hospitality Co.</div>
                <div>Built with ASP.NET MVC</div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
