@{
    ViewData["Title"] = "Gallery";
    ViewData["ShowAccentLine"] = true;
}

<section class="hero hero-unified">
    <div class="container">
        <div class="hero-shell shadow-soft">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <span class="badge-soft mb-3">
                        <i class="bi bi-camera"></i>
                        Recent work highlights
                    </span>
                    <h1 class="display-5 fw-bold">Photo gallery of our past service</h1>
                    <p class="lead text-muted mb-0">
                        To do: - Ask Darren what he wants in here
                    </p>
                </div>
                <div class="col-lg-6 hero-spacer"></div>
               
            </div>
        </div>
    </div>
</section>

