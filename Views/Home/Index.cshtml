@{
    ViewData["Title"] = "Home";
}

<section class="hero hero-unified">
    <div class="container">
        <div class="hero-shell shadow-soft">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <div class="badge-soft mb-3">
                        <i class="bi bi-fire me-2"></i> Temporary Staffing • Chefs • Events • Consultancy
                    </div>

                    <h1 class="display-5 fw-bold lh-sm">
                        Reliable chef cover & hospitality support —
                        <span class="text-brand">when you need it most</span>.
                    </h1>

                    <p class="lead text-muted mt-3">
                        From prep to pastry, pizzerias to fine dining. Short notice cover from 1 day onwards,
                        at an affordable rate compared to typical agencies.
                    </p>

                    <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                        <a class="btn btn-brand btn-lg" href="#contact">
                            <i class="bi bi-envelope me-1"></i> Get a quote
                        </a>
                        <a class="btn btn-outline-secondary btn-lg" href="#services">
                            View services <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </div>

                    <div class="trust-row mt-4">
                        <div class="trust-item">
                            <i class="bi bi-clock-history"></i>
                            <div>
                                <div class="fw-semibold">Fast cover</div>
                                <div class="text-muted small">From 1-day bookings</div>
                            </div>
                        </div>
                        <div class="trust-item">
                            <i class="bi bi-award"></i>
                            <div>
                                <div class="fw-semibold">Experienced</div>
                                <div class="text-muted small">~10 years in kitchens</div>
                            </div>
                        </div>
                        <div class="trust-item">
                            <i class="bi bi-geo-alt"></i>
                            <div>
                                <div class="fw-semibold">Local</div>
                                <div class="text-muted small">NI + border counties</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Keep this empty column so the left text stays half width -->
                <div class="col-lg-6 hero-spacer"></div>
            </div>
        </div>
    </div>
</section>


<section id="services" class="section">
    <div class="container">
        <div class="section-head">
            <h2 class="h1 fw-bold mb-2">Services</h2>
            <p class="text-muted mb-0">Flexible support designed for busy venues and growing teams.</p>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-md-4">
                <div class="card card-service h-100">
                    <div class="card-body">
                        <div class="icon-pill"><i class="bi bi-person-badge"></i></div>
                        <h3 class="h5 fw-bold mt-3">Chef Cover</h3>
                        <p class="text-muted mb-0">
                            Short-term kitchen cover while you recruit permanently. Suitable for prep, line, pastry, and more.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-service h-100">
                    <div class="card-body">
                        <div class="icon-pill"><i class="bi bi-calendar-event"></i></div>
                        <h3 class="h5 fw-bold mt-3">Events Support</h3>
                        <p class="text-muted mb-0">
                            Extra hands for busy periods, functions, and private events—helping service run smoothly.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-service h-100">
                    <div class="card-body">
                        <div class="icon-pill"><i class="bi bi-clipboard-check"></i></div>
                        <h3 class="h5 fw-bold mt-3">Consultancy</h3>
                        <p class="text-muted mb-0">
                            Practical advice on kitchen workflow, menu execution, and staffing strategy to reduce pressure.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="coverage" class="section section-alt">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <h2 class="h1 fw-bold mb-2">Coverage area</h2>
                <p class="text-muted">
                    Currently taking bookings across most of Northern Ireland, and open to border counties (e.g. Louth, Monaghan).
                </p>

                <div class="coverage-grid mt-3">
                    <div class="coverage-item"><i class="bi bi-check2-circle"></i> Belfast & Greater Belfast</div>
                    <div class="coverage-item"><i class="bi bi-check2-circle"></i> Newry & Mourne</div>
                    <div class="coverage-item"><i class="bi bi-check2-circle"></i> Antrim / Down / Armagh / Tyrone</div>
                    <div class="coverage-item"><i class="bi bi-check2-circle"></i> Border counties considered</div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-soft border-0 rounded-4">
                    <div class="card-body p-4 p-lg-5">
                        <h3 class="h5 fw-bold mb-2">Typical bookings</h3>
                        <p class="text-muted mb-3">
                            One-off shifts, holiday cover, sickness cover, recruitment gaps, and “all hands” weekends.
                        </p>

                        <div class="mini-steps">
                            <div class="mini-step">
                                <div class="step-dot">1</div>
                                <div>
                                    <div class="fw-semibold">Send details</div>
                                    <div class="text-muted small">Date, venue, shift times, section</div>
                                </div>
                            </div>
                            <div class="mini-step">
                                <div class="step-dot">2</div>
                                <div>
                                    <div class="fw-semibold">Confirm rate</div>
                                    <div class="text-muted small">Clear, upfront pricing</div>
                                </div>
                            </div>
                            <div class="mini-step">
                                <div class="step-dot">3</div>
                                <div>
                                    <div class="fw-semibold">Get cover</div>
                                    <div class="text-muted small">Professional support on site</div>
                                </div>
                            </div>
                        </div>

                        <a class="btn btn-brand mt-4 w-100" href="#contact">
                            <i class="bi bi-envelope me-1"></i> Book chef cover
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="about" class="section">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <h2 class="h1 fw-bold mb-2">About FiringLine</h2>
                <p class="text-muted mb-3">
                    Founded by Darren — a chef with nearly a decade of experience across the hospitality industry,
                    from pizzerias to fine dining.
                </p>
                <p class="text-muted mb-0">
                    The goal is simple: help venues stay consistent during staffing shortages with dependable,
                    skilled temporary support.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-num">1+</div>
                        <div class="stat-label">day cover onwards</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-num">~10</div>
                        <div class="stat-label">years experience</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-num">NI</div>
                        <div class="stat-label">primary coverage</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-num">✔</div>
                        <div class="stat-label">prep → pastry</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="contact" class="section cta">
    <div class="container">
        <div class="cta-card shadow-soft">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <h2 class="h1 fw-bold mb-2">Enquiries & bookings</h2>
                    <p class="text-muted mb-3">
                        We cover restaurants, events, and hotels, with consultancy available for menu restructure,
                        pricing, or a quick chat about taking your business to the next level.
                    </p>
                    <p class="text-muted mb-0">
                        For any of the above services contact Darren. If you miss a call, we’ll get back to you as soon as possible.
                    </p>
                </div>
                <div class="col-lg-5">
                    <div class="d-grid gap-2">
                        <a class="btn btn-outline-brand btn-lg" href="tel:+447746540776">
                            <i class="bi bi-telephone me-1"></i> 07746 540776
                        </a>
                        <a class="btn btn-brand btn-lg" href="mailto:firinglinehospitality@outlook.com?subject=Booking%20Enquiry%20-%20FiringLine">
                            <i class="bi bi-envelope me-1"></i> firinglinehospitality@outlook.com
                        </a>
                        <a class="btn btn-outline-brand btn-lg" href="#services">
                            <i class="bi bi-arrow-left-right me-1"></i> See services again
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
